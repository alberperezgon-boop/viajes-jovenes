{
  "_about": "Temas para reseñas de buscadores y reservas de viaje (ES + EN). Expresiones regulares, sin distinguir mayúsculas. kind: complaint (lo que odian) o request (lo que piden).",
  "request_patterns": [
    "\\bi wish\\b", "\\bplease add\\b", "\\bwould be (nice|great|good|helpful)\\b", "\\bwould love\\b", "\\bno way to\\b", "\\bthere'?s no (way|option)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b", "\\bif only\\b", "\\bwhy (can'?t|isn'?t|doesn'?t)\\b", "\\bshould (add|have|be able)\\b",
    "ojal[aá]", "deber[ií]an (poner|añadir|incluir|dejar|permitir)", "estar[ií]a (bien|genial)", "ser[ií]a (genial|bueno|útil|ideal)", "echo de menos", "no (te )?(deja|permite) ", "no se puede ", "falta(n)? (la |el |una |un |opci)"
  ],
  "themes": [
    {"id": "precio", "label": "Precio final distinto, comisiones y tasas ocultas", "kind": "complaint",
     "patterns": ["hidden (fee|charge|cost)", "price (changed|went up|increase|jump)", "different price", "extra (fee|charge)s?", "booking fee", "service fee", "more expensive", "comisi[oó]n", "\btasas?\b", "cargos? (extra|adicional|oculto)", "precio (final|distinto|diferente|cambia|sube|cambi[oó])", "m[aá]s caro", "sube el precio", "no es el (mismo )?precio"]},
    {"id": "reembolso", "label": "Cancelaciones y reembolsos", "kind": "complaint",
     "patterns": ["\\brefund", "\\bcancel(l?ed|lation|l?ing)?\\b", "reembols", "devoluci[oó]n", "devolver (el|mi) dinero", "cancelad[oa]", "cancelaci[oó]n", "\\bvoucher\\b", "\\bbono\\b"]},
    {"id": "reserva-falla", "label": "La reserva no vale al llegar (overbooking, no la encuentran, cambian)", "kind": "complaint",
     "patterns": ["overbook", "no (ten[ií]an|encontraban|aparec[ií]a) (mi|la|nuestra) reserva", "(couldn'?t|could not|didn'?t) find (my|our|the) (booking|reservation)", "reservation (was|got) (not|cancel)", "booking (was|got) cancel", "no (me|nos) dejaron (entrar|alojar|hacer el check)", "turned (us|me) away", "denied (check|boarding|entry)", "check.?in (was )?(refused|denied)"]},
    {"id": "soporte", "label": "Atención al cliente que no responde", "kind": "complaint",
     "patterns": ["customer (service|support)", "\\bsupport (team|is|was)\\b", "no (response|reply)", "never (replied|responded|heard back)", "\\bchat ?bot\\b", "atenci[oó]n al cliente", "servicio al cliente", "no (responden|contestan|me responden|me contestan)", "imposible contactar", "ning[uú]n (tel[eé]fono|contacto)"]},
    {"id": "fiabilidad", "label": "Engaño o poca fiabilidad (estafa, intermediarios dudosos)", "kind": "complaint",
     "patterns": ["\\bscam", "\\bfraud", "misleading", "\\bfake\\b", "estafa", "enga[ñn]o", "\btimo\b", "no fiable", "unreliable", "\\bthird.?party\\b", "intermediari", "agencia (dudosa|desconocida)"]},
    {"id": "pago", "label": "Problemas al pagar (tarjeta rechazada, cobros dobles)", "kind": "complaint",
     "patterns": ["card (declined|rejected|refused)", "payment (failed|declined|error)", "charged twice", "double charged", "tarjeta (rechazada|denegada|no (es )?v[aá]lida)", "cobr(o|ado|aron) (dos veces|doble)", "error (en|con|al) (el )?pago", "no (me )?deja pagar", "\\bpaypal\\b", "\\bapple pay\\b", "\\bbizum\\b"]},
    {"id": "edad", "label": "Edad, menores y documentos (menores de 18, DNI, pasaporte)", "kind": "complaint",
     "patterns": ["under ?18", "\\bminors?\\b", "\\bteen(ager)?s?\\b", "age (limit|restriction|requirement|policy)", "\\b1[67] (year|yo|y\\.o)", "menor(es)? de (edad|18)", "menores", "\\bedad\\b", "mayor de edad", "\\b1[678] a[ñn]os\\b", "autorizaci[oó]n (de los )?padres", "parental (consent|permission)"]},
    {"id": "bugs", "label": "Fallos y cuelgues de la app", "kind": "complaint",
     "patterns": ["crash(es|ed|ing)?", "\\bbugs?\\b", "\\bbuggy\\b", "glitch", "freez(e|es|ing)", "\\bbroken\\b", "(doesn'?t|does not|stopped) work", "not working", "\\berror\\b", "se (cierra|cuelga|queda colgad)", "no funciona", "no carga", "fallo", "\\berror(es)?\\b"]},
    {"id": "lento", "label": "Lenta o pesada", "kind": "complaint",
     "patterns": ["\\bslow\\b", "\\blag(gy|s)?\\b", "takes forever", "\\blent[ao]\\b", "tarda (mucho|una eternidad)", "carga(ndo)? (lent|eterna)"]},
    {"id": "uso", "label": "Confusa, filtros que no sirven", "kind": "complaint",
     "patterns": ["confus", "hard to (use|find|navigate)", "complicated", "cluttered", "unintuitive", "not intuitive", "clunky", "\\bfilters?\\b", "\\bfiltr(o|os|ar)\\b", "dif[ií]cil de (usar|encontrar|entender)", "complicad", "poco intuitiv", "no (se )?entiende"]},
    {"id": "cuenta", "label": "Login y cuenta", "kind": "complaint",
     "patterns": ["log ?in", "sign ?in", "password", "locked out", "verification code", "iniciar sesi[oó]n", "contrase[ñn]a", "c[oó]digo de verificaci[oó]n", "no puedo entrar"]},
    {"id": "spam", "label": "Notificaciones, anuncios y correos de más", "kind": "complaint",
     "patterns": ["notification", "\\bspam", "too many emails", "\\bads\\b", "\\badvert", "pop.?ups?", "notificaci", "publicidad", "anuncios", "demasiados correos"]},
    {"id": "update", "label": "Una actualización la empeoró", "kind": "complaint",
     "patterns": ["(new|latest|recent) (update|version|design)", "\\bredesign", "used to be", "bring back", "since the update", "(nueva|[uú]ltima) (actualizaci[oó]n|versi[oó]n)", "desde la actualizaci[oó]n", "antes (era|estaba|funcionaba)"]},
    {"id": "grupo", "label": "Viajar en grupo: reservar para varios, dividir pagos, compartir", "kind": "request",
     "patterns": ["\\bgroup (booking|travel|of)\\b", "split (the )?(payment|bill|cost)", "\\bshare (the )?(trip|itinerary|booking)", "with (my )?friends", "multiple (people|travell?ers|passengers)", "\\bgrupo\\b", "dividir (el )?pago", "compartir (el )?(viaje|itinerario|reserva)", "con (mis |unos )?amigos", "varias personas", "varios pasajeros"]},
    {"id": "alertas", "label": "Alertas y seguimiento de precio", "kind": "request",
     "patterns": ["price (alert|tracking|watch)", "\\balerts?\\b", "alerta(s)? de precio", "avisar (cuando|si) baja", "seguimiento de precio"]},
    {"id": "mapa", "label": "Mapa, ubicación y cómo llegar", "kind": "request",
     "patterns": ["\\bmaps?\\b", "location", "distance (to|from)", "how to get", "\\bmapa\\b", "ubicaci[oó]n", "distancia", "c[oó]mo llegar"]},
    {"id": "offline", "label": "Billetes y reservas sin conexión", "kind": "request",
     "patterns": ["\\boffline\\b", "without (internet|connection|wifi|data)", "sin (conexi[oó]n|internet|datos|cobertura)", "\\bwallet\\b", "descargar (el )?billete"]},
    {"id": "combinar", "label": "Combinar transporte y alojamiento en un solo sitio", "kind": "request",
     "patterns": ["all in one", "one place", "(train|bus) and (flight|hotel|hostel)", "combin(e|ar|ación)", "multimodal", "tren y (avi[oó]n|bus|hotel)", "todo en (uno|una|un mismo sitio)"]}
  ]
}
